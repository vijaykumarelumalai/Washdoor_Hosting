# ─── Supabase Configuration ─────────────────────────────────────
# Replace with your project details from Supabase Dashboard:
# Project Settings → API → Project URL & Project API Keys (anon / public)

REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Vite aliases (also supported automatically):
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ─── SECURITY NOTICE ───────────────────────────────────────────
# NEVER add service_role / secret keys here.
# Only the anon/public key should ever be used in frontend client apps.
